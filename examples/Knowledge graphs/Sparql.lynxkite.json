          "name": "node",
          "query": "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX scientist: <http://www.wikidata.org/entity/Q9021>\nPREFIX teacher_of:  <http://www.wikidata.org/prop/direct/P802>\n\nSELECT DISTINCT ?name ?generation\nWHERE {\n  {\n    BIND(scientist: AS ?person)\n    BIND(0 AS ?generation)\n    ?person teacher_of: ?student .\n  }\n  UNION\n  {\n    scientist: teacher_of: ?person .\n    BIND(1 AS ?generation)\n  }\nUNION\n  {\n     scientist: teacher_of: ?teacher .\n     BIND(2 AS ?generation)\n    ?teacher teacher_of: ?person .\n  }\n  ?person rdfs:label ?name . FILTER(LANG(?name) = \"en\")\n}\nLIMIT 1000"
        },
        "status": "done",
